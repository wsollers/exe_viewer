{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "clang18-debug",
      "displayName": "Clang 18 Debug (Ninja)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang-18",
        "CMAKE_CXX_COMPILER": "clang++-18",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++",
        "CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++"
      }
    },
    {
      "name": "clang18-release",
      "displayName": "Clang 18 Release (Ninja)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang-18",
        "CMAKE_CXX_COMPILER": "clang++-18",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++",
        "CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++"
      }
    },
    {
      "name": "clang18-asan-ubsan",
      "displayName": "Clang 18 ASan + UBSan (Ninja)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang-18",
        "CMAKE_CXX_COMPILER": "clang++-18",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++",
        "CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++",
        "PEELF_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "clang18-fuzz",
      "displayName": "Clang 18 Fuzzers (libFuzzer + ASan + UBSan)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang-18",
        "CMAKE_CXX_COMPILER": "clang++-18",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++",
        "CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++",
        "PEELF_ENABLE_FUZZERS": "ON",
        "PEELF_BUILD_VIEWER": "OFF",
        "PEELF_BUILD_GUI": "OFF",
        "PEELF_BUILD_TESTS": "OFF",
        "PEELF_BUILD_SHARED": "OFF"
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC 2022 Debug",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "PEELF_BUILD_VIEWER": "ON",
        "PEELF_BUILD_SHARED": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "clang18-debug",
      "configurePreset": "clang18-debug"
    },
    {
      "name": "clang18-release",
      "configurePreset": "clang18-release"
    },
    {
      "name": "clang18-asan-ubsan",
      "configurePreset": "clang18-asan-ubsan"
    },
    {
      "name": "clang18-fuzz",
      "configurePreset": "clang18-fuzz"
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug",
      "configuration": "Debug"
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-debug",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "clang18-debug",
      "configurePreset": "clang18-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "clang18-release",
      "configurePreset": "clang18-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "clang18-asan-ubsan",
      "configurePreset": "clang18-asan-ubsan",
      "output": { "outputOnFailure": true }
    }
  ]
}
