FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        clang-18 \
        clang-format-18 \
        clang-tidy-18 \
        cmake \
        gcc-aarch64-linux-gnu \
        gcc-riscv64-linux-gnu \
        git \
        graphviz \
        libgtk-3-dev \
        libc++-18-dev \
        libc++abi-18-dev \
        libc6-dev-arm64-cross \
        libc6-dev-riscv64-cross \
        libvulkan-dev \
        libwayland-dev \
        libx11-dev \
        libxkbcommon-dev \
        libxcursor-dev \
        libxi-dev \
        libxinerama-dev \
        libxrandr-dev \
        ninja-build \
        pkg-config \
        xorg-dev \
    && ln -sf /usr/bin/clang-format-18 /usr/local/bin/clang-format \
    && ln -sf /usr/bin/clang-tidy-18 /usr/local/bin/clang-tidy \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/exe_viewer

CMD ["bash"]
